# Application
SECRET_KEY=your-secret-key-min-32-chars-please-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-bytes-base64-encoded-change-me
DEBUG=False

# Database
DATABASE_URL=sqlite:///./data/c2panel.db

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SESSION_TIMEOUT=28800
PASSWORD_MIN_LENGTH=12

# Monitoring
HOST_CHECK_INTERVAL=180
PING_TIMEOUT=10

# Tasks
MAX_CONCURRENT_TASKS=150
DEFAULT_TASK_TIMEOUT=300
DEFAULT_GSOCKET_WAIT=10

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
TASK_RETENTION_DAYS=180
